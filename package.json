{
  "name": "shamrock-pos",
  "version": "1.0.30",
  "description": "Shamrock Market POS Desktop App",
  "author": "Shamrock Market",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist-mac": "electron-builder --mac",
    "dist-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.shamrock.pos",
    "productName": "Shamrock POS",
    "copyright": "Copyright 2024 Shamrock Market",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "index.html",
      "login.html",
      "products.html",
      "settings.html",
      "reports.html",
      "customer-display.html",
      "styles.css",
      "main.js",
      "server.js",
      "database.js",
      "printer.js",
      "preload.js",
      "!dist/**",
      "!*.md",
      "!.git/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "shamrock.db",
        "to": "shamrock.db"
      },
      {
        "from": "sales.json",
        "to": "sales.json"
      },
      {
        "from": "products.json",
        "to": "products.json"
      },
      {
        "from": "settings.json",
        "to": "settings.json"
      },
      {
        "from": "reports.json",
        "to": "reports.json"
      },
      {
        "from": "shamrock-pos-credentials.json",
        "to": "shamrock-pos-credentials.json"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "marketing-images",
        "to": "marketing-images"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "asarUnpack": [
      "node_modules/printer/**/*",
      "node_modules/escpos/**/*",
      "node_modules/escpos-usb/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shamrock POS",
      "license": null,
      "perMachine": false,
      "allowElevation": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "offers-png",
        "repo": "shamrock-1zip",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.6.2",
    "escpos": "^3.0.0-alpha.6",
    "express": "^4.22.1",
    "googleapis": "^128.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^24.9.1"
  },
  "optionalDependencies": {
    "escpos-usb": "^3.0.0-alpha.4",
    "printer": "^0.4.0"
  }
}
